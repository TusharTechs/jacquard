# Dependencies
node_modules/
.pnpm-store/
.pnpm-debug.log*

# Build output
dist/
!power/dist/
!power/dist/**
build/
out/
coverage/
*.tsbuildinfo
.turbo/
.next/
.cache/

# Environment and secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json


# NOTE: .kiro/ is intentionally NOT ignored.

# Local evidence that hooks ran (written by .kiro/hooks; already covered by *.log, listed explicitly)
.kiro/hook-runs.log

# Screen recordings of the build journey (large; the edited video goes to YouTube)
media/**/*.mov
media/**/*.mp4
media/**/*.mkv
# Deploy state: the Amplify app id (deploy-static 2.3). Never commit.
.deploy/
# Demo video (demo-video 1.2): copied media, capture, audio stems and renders are generated
video/public/
# Narration line files (demo-video 8.1, 9.3), made locally by `pnpm --filter @jacquard/video tts`
video/voice/lines/*.wav
video/voice/lines/*.json
# The synthetic voice's Python venv (demo-video 9.1); pyproject.toml and uv.lock are committed
video/voice/tts/.venv/
# Generated locally by `pnpm --filter @jacquard/video script` (demo-video 2.2, 8.2); not committed
video/script.md
video/voice/RECORDING.md
video/capture/frames/
video/test-results/
video/playwright-report/
# Local notes kept on this machine only (research and planning material)
private/
