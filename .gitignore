# Dependencies
node_modules/
.pnpm-store/
.pnpm-debug.log*

# Build output
dist/
build/
out/
coverage/
*.tsbuildinfo
.turbo/
.next/
.cache/

# Environment and secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json


# NOTE: .kiro/ is intentionally NOT ignored.

# Local evidence that hooks ran (written by .kiro/hooks; already covered by *.log, listed explicitly)
.kiro/hook-runs.log

# Screen recordings of the build journey (large; the edited video goes to YouTube)
media/**/*.mov
media/**/*.mp4
